[Unit]
Description=Adoluna Support password push sidecar (proxy for rustdesk-api :21114)
After=network-online.target docker.service
Wants=network-online.target

[Service]
ExecStart=/usr/bin/python3 /opt/rustdesk/pwpush/pwpush.py
Restart=always
RestartSec=2
User=root

[Install]
WantedBy=multi-user.target
